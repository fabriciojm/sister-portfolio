---
import { getCollection } from 'astro:content';

const projects = [
  { type: 'project', title: 'Small Hours', meta: 'Brand identity · 2026', description: 'A gentle identity system for a neighbourhood bakery that wakes before the city.', art: 'sun', number: '01' },
  { type: 'project', title: 'Root & River', meta: 'Packaging · 2025', description: 'Botanical packaging for a small-batch line of sparkling drinks.', art: 'bottle', number: '03' },
  { type: 'project', title: 'The Sunday Table', meta: 'Editorial · 2025', description: 'A seasonal recipe journal built around shared tables and slow afternoons.', art: 'table', number: '05' },
  { type: 'project', title: 'Bramble', meta: 'Digital product · 2024', description: 'A pocket-sized field guide for curious walkers and amateur naturalists.', art: 'bramble', number: '06' },
].map((project) => ({ ...project, href: '#' }));

const posts = (await getCollection('blog')).map((post) => ({
  type: 'blog',
  ...post.data,
  href: `/blog/${post.id}/`,
}));

const entries = [...projects, ...posts].sort((a, b) => Number(a.number) - Number(b.number));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="The selected work and occasional notes of Lucy Hart." />
    <link rel="icon" href="/favicon.svg" />
    <title>Lucy Hart — selected work & notes</title>
  </head>
  <body>
    <a class="skip-link" href="#work">Skip to work</a>
    <aside class="sidebar">
      <a class="brand" href="#top" aria-label="Lucy Hart, home"><span>Lucy</span><span>Hart</span><i aria-hidden="true"></i></a>
      <nav aria-label="Portfolio filters">
        <button class="nav-link is-active" type="button" data-filter="all" aria-pressed="true">Everything</button>
        <button class="nav-link" type="button" data-filter="blog" aria-pressed="false">Blog <sup>{posts.length}</sup></button>
        <button class="nav-link" type="button" data-filter="project" aria-pressed="false">Projects <sup>{projects.length}</sup></button>
        <a class="nav-link" href="/about/">About</a>
      </nav>
      <div class="sidebar-bottom">
        <p>Independent designer,<br />maker & enthusiastic<br />collector of small things.</p>
        <a href="mailto:hello@lucyhart.studio">Say hello ↗</a>
      </div>
    </aside>

    <main id="top">
      <header class="intro">
        <p class="eyebrow">Selected work & occasional notes</p>
        <h1>I make thoughtful things<br />with <em>colour</em> and care.</h1>
        <div class="scribble" aria-hidden="true">✳</div>
      </header>
      <section class="grid" id="work" aria-live="polite">
        {entries.map((entry) => (
          <article class={`card card--${entry.art}`} data-type={entry.type}>
            <a href={entry.href} aria-label={`View ${entry.title}`}>
              <div class="art" aria-hidden="true">
                <span class="card-number">{entry.number}</span>
                <div class="shape shape-a"></div><div class="shape shape-b"></div><div class="shape shape-c"></div>
                <span class="art-word">{entry.title.split(' ')[0]}</span>
              </div>
              <div class="card-copy">
                <p class="meta"><span>{entry.type}</span>{entry.meta}</p>
                <h2>{entry.title}</h2><p>{entry.description}</p><span class="arrow" aria-hidden="true">↗</span>
              </div>
            </a>
          </article>
        ))}
      </section>
      <footer><p>Made with curiosity in Paris.</p><p>© 2026 Lucy Hart</p></footer>
    </main>

    <script>
      const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
      const cards = document.querySelectorAll<HTMLElement>('[data-type]');
      buttons.forEach((button) => button.addEventListener('click', () => {
        const filter = button.dataset.filter;
        buttons.forEach((item) => { const active = item === button; item.classList.toggle('is-active', active); item.setAttribute('aria-pressed', String(active)); });
        cards.forEach((card) => { card.hidden = filter !== 'all' && card.dataset.type !== filter; });
      }));
    </script>
  </body>
</html>

<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=DM+Serif+Display:ital@0;1&display=swap');
  :root { --ink:#17251c; --paper:#f7f5ef; --red:#f04427; --green:#1ca36b; --yellow:#ffd631; }
  * { box-sizing:border-box; } html { scroll-behavior:smooth; } body { margin:0; background:var(--paper); color:var(--ink); font-family:'DM Sans',sans-serif; } a { color:inherit; } button { font:inherit; }
  .skip-link { position:fixed; left:1rem; top:-4rem; z-index:20; padding:.7rem 1rem; background:var(--ink); color:white; } .skip-link:focus { top:1rem; }
  .sidebar { position:fixed; inset:0 auto 0 0; z-index:5; width:240px; padding:28px 28px 34px; border-right:1px solid #17251c33; display:flex; flex-direction:column; background:var(--paper); }
  .brand { width:144px; height:144px; padding:30px 25px; border-radius:50%; display:flex; flex-direction:column; justify-content:center; background:var(--red); color:white; font:2.5rem/.76 'DM Serif Display',serif; text-decoration:none; transform:rotate(-4deg); }
  .brand span:last-of-type { margin-left:24px; font-style:italic; } .brand i { width:34px; height:3px; margin:15px 0 0 30px; background:var(--yellow); transform:rotate(-8deg); }
  nav { display:flex; flex-direction:column; align-items:flex-start; gap:7px; margin-top:48px; } .nav-link { padding:1px 0; border:0; background:none; color:var(--ink); font:1.7rem 'DM Serif Display',serif; cursor:pointer; }
  .nav-link::after { content:''; display:block; width:0; height:3px; background:var(--red); transition:width .2s ease; } .nav-link:hover::after,.nav-link.is-active::after { width:100%; } .nav-link sup { color:var(--red); font:500 .65rem 'DM Sans',sans-serif; vertical-align:top; }
  .sidebar-bottom { margin-top:auto; font-size:.8rem; line-height:1.5; } .sidebar-bottom a { font-weight:600; text-decoration-thickness:2px; text-underline-offset:3px; }
  main { margin-left:240px; } .intro { position:relative; min-height:440px; padding:75px clamp(42px,7vw,110px) 55px; display:flex; flex-direction:column; justify-content:center; border-bottom:1px solid #17251c33; overflow:hidden; }
  .eyebrow { margin:0 0 24px; color:var(--green); font-size:.74rem; font-weight:600; letter-spacing:.15em; text-transform:uppercase; } h1 { max-width:900px; margin:0; font:400 clamp(3.2rem,7vw,7rem)/.94 'DM Serif Display',serif; letter-spacing:-.035em; }
  h1 em { color:var(--red); font-weight:400; } .scribble { position:absolute; right:7%; bottom:42px; color:var(--yellow); font-size:7rem; line-height:1; transform:rotate(18deg); }
  .grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); } .card { border-right:1px solid #17251c33; border-bottom:1px solid #17251c33; } .card:nth-child(2n) { border-right:0; } .card[hidden] { display:none; } .card>a { display:block; height:100%; text-decoration:none; }
  .art { position:relative; aspect-ratio:4/3; overflow:hidden; background:#ddd; } .shape { position:absolute; transition:transform .45s cubic-bezier(.2,.8,.2,1); } .card:hover .shape-a { transform:rotate(8deg) scale(1.05); } .card:hover .shape-b { transform:translate(8px,-8px) rotate(-6deg); }
  .card-number { position:absolute; z-index:2; top:18px; left:20px; font-size:.7rem; font-weight:600; } .art-word { position:absolute; z-index:2; right:6%; bottom:5%; font:italic 3.4rem/1 'DM Serif Display',serif; }
  .card-copy { position:relative; min-height:190px; padding:24px 70px 32px 26px; } .card-copy .meta { margin:0 0 11px; color:#687269; font-size:.72rem; letter-spacing:.04em; text-transform:uppercase; } .meta span { margin-right:12px; padding:4px 8px; border-radius:999px; background:var(--yellow); color:var(--ink); font-weight:600; }
  .card-copy h2 { margin:0 0 8px; font:400 2rem/1.1 'DM Serif Display',serif; } .card-copy>p:last-of-type { max-width:460px; margin:0; color:#536057; font-size:.9rem; line-height:1.5; } .arrow { position:absolute; right:26px; top:30px; font-size:1.5rem; transition:transform .2s; } .card:hover .arrow { transform:translate(4px,-4px); }
  .card--sun .art { background:#8ab9ea; } .card--sun .shape-a { width:44%; aspect-ratio:1; left:28%; top:18%; border-radius:50%; background:var(--yellow); } .card--sun .shape-b { width:38%; height:25%; left:31%; bottom:0; border-radius:50% 50% 0 0; background:var(--red); }
  .card--tiles .art { background:#ef684e; } .card--tiles .shape-a { inset:12% 12% 14%; background:repeating-linear-gradient(90deg,transparent 0 15%,var(--paper) 15% 17%),repeating-linear-gradient(0deg,transparent 0 22%,var(--paper) 22% 24%); border:4px solid var(--paper); transform:rotate(-3deg); } .card--tiles .shape-b { width:18%; aspect-ratio:1; right:18%; top:23%; border-radius:50%; background:var(--yellow); }
  .card--bottle .art { background:#f1b8ce; } .card--bottle .shape-a { width:25%; height:65%; left:38%; top:20%; border-radius:45% 45% 18% 18%; background:#155c42; transform:rotate(5deg); } .card--bottle .shape-b { width:19%; height:28%; left:41%; top:38%; border-radius:50%; background:var(--yellow); }
  .card--play .art { background:var(--yellow); } .card--play .shape-a { width:48%; aspect-ratio:1; left:12%; top:16%; border-radius:52% 48% 60% 40%; background:#4a82d0; transform:rotate(12deg); } .card--play .shape-b { width:28%; aspect-ratio:1; right:12%; bottom:13%; border-radius:50%; background:var(--red); } .card--play .shape-c { width:13%; aspect-ratio:1; left:48%; top:12%; border-radius:50%; background:var(--paper); }
  .card--table .art { background:#183f31; } .card--table .shape-a { width:60%; aspect-ratio:1; left:20%; top:8%; border:34px solid #e6a230; border-radius:50%; } .card--table .shape-b { width:35%; aspect-ratio:1; left:32%; top:25%; border-radius:50%; background:#f6efe2; } .card--table .art-word { color:white; }
  .card--bramble .art { background:#dce4cd; } .card--bramble .shape-a { width:42%; height:110%; left:26%; top:-5%; border:18px dotted #2a7d51; border-radius:50%; transform:rotate(25deg); } .card--bramble .shape-b { width:26%; aspect-ratio:1; left:37%; top:27%; border-radius:50% 10% 50% 10%; background:#91364d; }
  footer { padding:28px 40px; display:flex; justify-content:space-between; color:#687269; font-size:.72rem; }
  @media(max-width:780px) { .sidebar { position:sticky; top:0; width:100%; height:auto; padding:13px 18px; flex-direction:row; align-items:center; border-right:0; border-bottom:1px solid #17251c33; } .brand { width:auto; height:auto; padding:0; display:block; background:none; color:var(--red); font-size:1.55rem; transform:none; } .brand span { display:inline; } .brand span:last-of-type { margin-left:5px; } .brand i { display:none; } nav { margin:0 0 0 auto; flex-direction:row; gap:15px; } .nav-link { font-family:'DM Sans',sans-serif; font-size:.8rem; font-weight:600; } .nav-link:first-child,.sidebar-bottom { display:none; } main { margin-left:0; } .intro { min-height:390px; padding:65px 24px 45px; } h1 { font-size:clamp(3.1rem,15vw,5.4rem); } .scribble { right:5%; bottom:22px; font-size:4rem; } .grid { grid-template-columns:1fr; } .card { border-right:0; } }
  @media(prefers-reduced-motion:reduce) { html { scroll-behavior:auto; } *,*::before,*::after { transition:none!important; } }
</style>
