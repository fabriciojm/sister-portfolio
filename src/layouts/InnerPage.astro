---
interface Props {
  title: string;
  description: string;
  section?: string;
}

const { title, description, section = 'Page' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" />
    <title>{title} — Lucy Hart</title>
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <aside class="sidebar">
      <a class="brand" href="/" aria-label="Lucy Hart, home"><span>Lucy</span><span>Hart</span><i aria-hidden="true"></i></a>
      <nav aria-label="Main navigation">
        <a href="/#work">Blog</a>
        <a href="/#work">Projects</a>
        <a href="/about/" class:list={{ active: section === 'About' }}>About</a>
      </nav>
      <div class="sidebar-bottom">
        <p>Independent designer,<br />maker & enthusiastic<br />collector of small things.</p>
        <a href="mailto:hello@lucyhart.studio">Say hello ↗</a>
      </div>
    </aside>
    <main id="content">
      <slot />
      <footer><a href="/">← Back home</a><p>© 2026 Lucy Hart</p></footer>
    </main>
  </body>
</html>

<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=DM+Serif+Display:ital@0;1&display=swap');
  :root { --ink:#17251c; --paper:#f7f5ef; --red:#f04427; --green:#1ca36b; --yellow:#ffd631; }
  * { box-sizing:border-box; }
  html { scroll-behavior:smooth; }
  body { margin:0; background:var(--paper); color:var(--ink); font-family:'DM Sans',sans-serif; }
  a { color:inherit; }
  .skip-link { position:fixed; left:1rem; top:-4rem; z-index:20; padding:.7rem 1rem; background:var(--ink); color:white; }
  .skip-link:focus { top:1rem; }
  .sidebar { position:fixed; inset:0 auto 0 0; z-index:5; width:240px; padding:28px 28px 34px; border-right:1px solid #17251c33; display:flex; flex-direction:column; background:var(--paper); }
  .brand { width:144px; height:144px; padding:30px 25px; border-radius:50%; display:flex; flex-direction:column; justify-content:center; background:var(--red); color:white; font:2.5rem/.76 'DM Serif Display',serif; text-decoration:none; transform:rotate(-4deg); }
  .brand span:last-of-type { margin-left:24px; font-style:italic; }
  .brand i { width:34px; height:3px; margin:15px 0 0 30px; background:var(--yellow); transform:rotate(-8deg); }
  nav { display:flex; flex-direction:column; align-items:flex-start; gap:7px; margin-top:48px; }
  nav a { font:1.7rem 'DM Serif Display',serif; text-decoration:none; }
  nav a::after { content:''; display:block; width:0; height:3px; background:var(--red); transition:width .2s; }
  nav a:hover::after, nav a.active::after { width:100%; }
  .sidebar-bottom { margin-top:auto; font-size:.8rem; line-height:1.5; }
  .sidebar-bottom a { font-weight:600; text-underline-offset:3px; }
  main { min-height:100vh; margin-left:240px; }
  .page-header { position:relative; padding:95px clamp(38px,8vw,120px) 70px; border-bottom:1px solid #17251c33; overflow:hidden; }
  .eyebrow { margin:0 0 20px; color:var(--green); font-size:.74rem; font-weight:600; letter-spacing:.15em; text-transform:uppercase; }
  h1 { max-width:900px; margin:0; font:400 clamp(3.3rem,7vw,7rem)/.95 'DM Serif Display',serif; letter-spacing:-.035em; }
  .dek { max-width:680px; margin:25px 0 0; color:#536057; font-size:1.15rem; line-height:1.6; }
  .article, .about-copy { max-width:760px; padding:70px clamp(28px,8vw,120px) 100px; font-size:1.05rem; line-height:1.8; }
  .article h2, .about-copy h2 { margin:2.3em 0 .5em; font:400 2.2rem/1.1 'DM Serif Display',serif; }
  .article p, .about-copy p { margin:0 0 1.5em; }
  .article blockquote { margin:2.2rem 0; padding:1.5rem 0 1.5rem 2rem; border-left:6px solid var(--yellow); font:italic 1.7rem/1.35 'DM Serif Display',serif; }
  .article li { margin:.45rem 0; }
  .article a { text-decoration-color:var(--red); text-decoration-thickness:2px; }
  .date { display:inline-block; margin-top:30px; padding:7px 12px; border-radius:999px; background:var(--yellow); font-size:.75rem; font-weight:600; text-transform:uppercase; }
  .accent { color:var(--red); font-style:italic; }
  .about-note { margin-top:3rem; padding:28px; background:var(--yellow); font:1.5rem/1.35 'DM Serif Display',serif; transform:rotate(-1deg); }
  footer { padding:28px 40px; border-top:1px solid #17251c33; display:flex; justify-content:space-between; color:#687269; font-size:.72rem; }
  footer a { font-weight:600; }
  @media(max-width:780px) {
    .sidebar { position:sticky; top:0; width:100%; height:auto; padding:13px 18px; flex-direction:row; align-items:center; border-right:0; border-bottom:1px solid #17251c33; }
    .brand { width:auto; height:auto; padding:0; display:block; background:none; color:var(--red); font-size:1.55rem; transform:none; }
    .brand span { display:inline; } .brand span:last-of-type { margin-left:5px; } .brand i,.sidebar-bottom { display:none; }
    nav { margin:0 0 0 auto; flex-direction:row; gap:15px; }
    nav a { font:600 .8rem 'DM Sans',sans-serif; }
    main { margin-left:0; }
    .page-header { padding:70px 24px 50px; }
    .article,.about-copy { padding:50px 24px 70px; }
  }
</style>

